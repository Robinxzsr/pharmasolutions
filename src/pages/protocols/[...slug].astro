---
/**
 * One protocol's own page — reached by clicking its shop-front card.
 *
 * The pre-order button goes straight to that protocol's Stripe Payment Link
 * (a hosted checkout page), so no card details ever touch this site and
 * nothing needs wiring through /api/checkout — that endpoint validates
 * against the `plans` collection and is for the coaching tiers, not these.
 * The link is per-protocol in the content collection, so each guide can get
 * its own once they exist; today they all point at the same one.
 *
 * The masthead here is bespoke (back-link, then cover beside title/price/CTA)
 * rather than the standard title+lede, so it uses the `masthead-top` utility
 * directly instead of PageHeader. Same single source of truth for the vertical
 * position either way — see global.css for the measurements behind it.
 */
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import CoverPlaceholder from "../../components/ui/CoverPlaceholder.astro";

export const getStaticPaths = (async () => {
  const protocols = await getCollection("protocols");
  return protocols.map((protocol) => ({ params: { slug: protocol.id }, props: { protocol } }));
}) satisfies GetStaticPaths;

const { protocol } = Astro.props;
const { name, summary, priceDisplay, checkoutUrl, cover, coverAlt } = protocol.data;
const { Content } = await render(protocol);
---

<BaseLayout title={name} description={summary}>
  <Section space="md" glow="top" class="masthead-top">
    <Container>
      <a href="/protocols" class="text-sm text-content-muted transition-colors hover:text-chalk">
        &larr; All protocols
      </a>

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,20rem)_1fr]">
        {
          cover ? (
            <Image
              src={cover}
              alt={coverAlt ?? ""}
              widths={[400, 640, 800]}
              sizes="(min-width: 1024px) 20rem, 90vw"
              class="aspect-[16/10] w-full rounded-card object-cover"
            />
          ) : (
            <CoverPlaceholder class="aspect-[16/10] w-full rounded-card" />
          )
        }

        <div>
          <h1 class="text-[length:var(--text-display-md)]">{name}</h1>
          <p class="mt-3 max-w-lg text-lg text-content-muted">{summary}</p>
          <p class="mt-6 font-display text-2xl font-bold text-brand-soft">{priceDisplay}</p>

          <Button href={checkoutUrl} variant="glow" size="lg" class="mt-8">Pre-order</Button>
        </div>
      </div>
    </Container>
  </Section>

  <Section space="md" divider>
    <Container width="prose" class="prose-body">
      <Content />
    </Container>
  </Section>
</BaseLayout>
