---
/**
 * One protocol's own page — reached by clicking its shop-front card.
 *
 * The purchase button routes to /enrol rather than a real checkout: unlike
 * `plans`, protocols don't have Stripe price ids yet (see content.config.ts).
 * /api/checkout only validates against the `plans` collection today. Wiring
 * individual-guide checkout is real follow-up work, not a decision to make
 * silently inside a design pass — sending interest to /enrol in the meantime
 * beats shipping a button that does nothing.
 */
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import CoverPlaceholder from "../../components/protocols/CoverPlaceholder.astro";

export const getStaticPaths = (async () => {
  const protocols = await getCollection("protocols");
  return protocols.map((protocol) => ({ params: { slug: protocol.id }, props: { protocol } }));
}) satisfies GetStaticPaths;

const { protocol } = Astro.props;
const { name, summary, priceDisplay, cover, coverAlt } = protocol.data;
const { Content } = await render(protocol);
---

<BaseLayout title={name} description={summary}>
  <Section space="md" glow="top" class="pt-40">
    <Container>
      <a href="/protocols" class="text-sm text-content-muted transition-colors hover:text-chalk">
        &larr; All protocols
      </a>

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr]">
        {
          cover ? (
            <Image
              src={cover}
              alt={coverAlt ?? ""}
              widths={[440, 640, 880]}
              sizes="(min-width: 1024px) 22rem, 90vw"
              class="aspect-[3/4] w-full rounded-card object-cover"
            />
          ) : (
            <CoverPlaceholder class="aspect-[3/4] w-full rounded-card" />
          )
        }

        <div>
          <h1 class="text-[length:var(--text-display-md)]">{name}</h1>
          <p class="mt-3 max-w-lg text-lg text-content-muted">{summary}</p>
          <p class="mt-6 font-display text-2xl font-bold text-brand-soft">{priceDisplay}</p>

          <Button href="/enrol" variant="glow" size="lg" class="mt-8">
            Purchase — register interest
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <Section space="md" divider>
    <Container width="prose" class="prose-body">
      <Content />
    </Container>
  </Section>
</BaseLayout>
