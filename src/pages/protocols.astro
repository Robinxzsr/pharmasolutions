---
/**
 * Protocols — the shop front. A grid of one-time-purchase guides, each card
 * linking through to its own detail page.
 *
 * Not routed through PageLayout: PageLayout follows its masthead with a narrow
 * prose Container, the wrong measure for a card grid. It composes the same
 * PageHeader directly instead, with the grid as PageHeader's children so the
 * heading and grid share one band — as two Sections they stacked py-24 on
 * py-24 into 192px of dead space between the lede and the first card.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import ProtocolCard from "../components/protocols/ProtocolCard.astro";
import { getCollection } from "astro:content";

const protocols = (await getCollection("protocols")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Protocols"
  description="One time purchase for the most detailed guides on the market."
>
  <PageHeader
    title="Protocols"
    lede="One time purchase for the most detailed guides on the market."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {protocols.map((protocol) => <ProtocolCard protocol={protocol} />)}
    </div>
  </PageHeader>
</BaseLayout>
