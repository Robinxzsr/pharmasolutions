---
/**
 * Pricing — plan cards wired to Stripe Checkout.
 *
 * Plans come from the content collection; the button posts the price id to
 * /api/checkout, which re-validates it server-side before charging.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Container from "../components/ui/Container.astro";
import { getCollection } from "astro:content";

const plans = (await getCollection("plans")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Pricing" description="Coaching plans and protocol access.">
  <Section space="md" glow="top" class="masthead-top">
    <Container>
      <h1 class="text-[length:var(--text-display-lg)]">Pricing</h1>
    </Container>
  </Section>

  <Section space="md">
    <Container>
      <div class="grid gap-6 md:grid-cols-3">
        {
          plans.map((plan) => (
            <article
              class:list={[
                "bitmap flex flex-col p-8 [--bitmap-step:4px] [--bitmap-ink-w:2px] [--bitmap-fill:var(--color-surface-raised)]",
                /* The recommended plan was marked by a border colour AND a
                   glow — two elevation systems stacked on one card. It is
                   marked here the way the plate marks anything: violet ink,
                   and a standing halftone screen the other cards do not
                   carry. Tone, not a halo. */
                plan.data.highlighted
                  ? "[--bitmap-ink:var(--color-violet-500)] [--bitmap-dot:var(--color-violet-500)] [--dot-r:0.6px]"
                  : "",
              ]}
            >
              <h2 class="text-[length:var(--text-display-sm)]">{plan.data.name}</h2>
              <p class="mt-2 text-content-muted">{plan.data.blurb}</p>
              <p class="mt-6 text-[length:var(--text-display-sm)] text-brand-soft">
                {plan.data.priceDisplay}
              </p>

              <ul class="mt-6 flex flex-col gap-2 text-content-muted">
                {plan.data.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>

              <button
                type="button"
                data-checkout={plan.data.stripePriceId}
                class:list={[
                  "bitmap mt-8 px-6 py-3 font-display font-bold disabled:opacity-50",
                  "hover:[--dot-r:0.95px] focus-visible:[--dot-r:0.95px]",
                  plan.data.highlighted
                    ? "text-chalk [--bitmap-ink:var(--color-violet-500)] [--bitmap-fill:var(--color-violet-500)] [--bitmap-dot:var(--color-void-950)] hover:[--bitmap-ink:var(--color-violet-300)]"
                    : "text-void-950 [--bitmap-ink:var(--color-chalk)] [--bitmap-fill:var(--color-chalk)] [--bitmap-dot:var(--color-void-950)]",
                ]}
              >
                Choose {plan.data.name}
              </button>
            </article>
          ))
        }
      </div>

      <p data-checkout-status role="status" aria-live="polite" class="mt-6 min-h-5 text-sm text-content-muted"></p>
    </Container>
  </Section>
</BaseLayout>

<script>
  function initCheckout() {
    const status = document.querySelector<HTMLElement>("[data-checkout-status]");

    document.querySelectorAll<HTMLButtonElement>("[data-checkout]").forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "true";

      button.addEventListener("click", async () => {
        button.disabled = true;
        if (status) status.textContent = "Opening secure checkout…";

        try {
          const response = await fetch("/api/checkout", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ priceId: button.dataset.checkout }),
          });
          const result = await response.json();

          // Hand off to Stripe's hosted page — we never touch card details.
          if (response.ok && result.url) {
            window.location.href = result.url;
            return;
          }

          if (status) status.textContent = result.message ?? "Could not start checkout.";
        } catch {
          if (status) status.textContent = "Network error. Please try again.";
        } finally {
          button.disabled = false;
        }
      });
    });
  }

  initCheckout();
  document.addEventListener("astro:page-load", initCheckout);
</script>
