---
/**
 * Home — the 3D hero, then straight into the footer.
 *
 * The footer's first band is the "Stay in the loop" capture (see
 * Footer.astro), so keeping this page to just the hero puts that section
 * directly beneath it, with no placeholder content between them.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/hero/Hero.astro";
import HeroPreload from "../components/hero/HeroPreload.astro";
import { site } from "../lib/site";
---

<BaseLayout title="Home" description={site.description}>
  {/* Starts the plate and the model downloading from the initial HTML. */}
  <HeroPreload slot="head" />

  <Hero
    heading="Enhance or be left behind"
    subheading="Personalized pharmacology for those who know the world is theirs for the taking"
    primaryCta={{ label: "Protocols", href: "/protocols" }}
    secondaryCta={{ label: "Coaching", href: "/coaching" }}
  />
</BaseLayout>
