---
/**
 * BaseLayout — the only place that owns <head>.
 *
 * Every page renders through this (usually via PageLayout). It handles SEO,
 * font preloading, and the header/footer frame. Pages supply content only.
 */
import { Font } from "astro:assets";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { site } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative path to the social share image. */
  ogImage?: string;
  /** Suppresses indexing for thank-you pages, drafts, etc. */
  noindex?: boolean;
}

const { title, description = site.description, ogImage, noindex = false } = Astro.props;

/** Home gets the bare brand name; everything else is suffixed. */
const pageTitle =
  Astro.url.pathname === "/" ? `${site.name} — ${site.tagline}` : `${title} · ${site.name}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const socialImage = new URL(ogImage ?? "/og-default.png", Astro.site ?? site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Emits @font-face + preload links for the self-hosted families. */}
    <Font cssVariable="--font-neuebit" preload />
    <Font cssVariable="--font-mondwest" preload />
    <Font cssVariable="--font-editorial" />

    <slot name="head" />
  </head>

  <body class="min-h-dvh bg-surface text-content">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-chalk focus:px-4 focus:py-2 focus:text-void-950"
    >
      Skip to content
    </a>

    {/*
      Header and main share one grid cell (both col/row-start-1) so Header
      overlays the top of main's content without needing to know its own
      height in advance — the fluid clamp() typography in Header makes that
      height genuinely variable, so a fixed negative-margin overlap trick
      would drift at in-between viewport widths. The cell's own size is
      governed by main (far taller, as it holds the whole page), and Header
      simply paints on top of main's top edge via z-index.

      This is also what makes Header's own <nav> a real in-flow element
      again, so its `position: sticky` behaves like sticky is supposed to:
      scrolling normally at first, then catching at `top: 0` once it would
      scroll past it — instead of the always-pinned-from-load `fixed`
      approach from the last two commits, which wasn't actually what was
      wanted.
    */}
    <div class="grid">
      <Header />

      <main id="main" class="col-start-1 row-start-1">
        <slot />
      </main>
    </div>

    <Footer />
  </body>
</html>
