---
/**
 * PageLayout — standard content page.
 *
 * Wraps BaseLayout with a titled masthead, for pages that are mostly prose
 * (About, FAQ, Legal). The home page composes Hero + Sections directly on
 * BaseLayout instead.
 */
import BaseLayout from "./BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Container from "../components/ui/Container.astro";

interface Props {
  title: string;
  description?: string;
  /** Optional deck shown under the page title. */
  lede?: string;
  noindex?: boolean;
}

const { title, description, lede, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Section space="md" glow="top" class="pt-40">
    <Container>
      <h1 class="text-[length:var(--text-display-lg)]">{title}</h1>
      {lede && <p class="mt-5 max-w-xl text-lg text-content-muted">{lede}</p>}
    </Container>
  </Section>

  <Section space="md">
    <Container width="prose" class="prose-body">
      <slot />
    </Container>
  </Section>
</BaseLayout>
