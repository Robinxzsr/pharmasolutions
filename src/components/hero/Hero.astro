---
/**
 * Hero — the full-viewport 3D opening.
 *
 * The CSS background paints the plate as soon as it decodes, long before
 * three.js is ready; the canvas later draws the same image with the same
 * cover-fit on top, so the handoff is invisible. Copy is held back until the
 * scene has rendered a frame, so the whole hero arrives as one fade.
 *
 * Asset URLs are passed as data attributes rather than `define:vars`, because
 * `define:vars` forces the script inline and it would lose bundling.
 */
import heroBg from "../../assets/hero/hero-bg.webp";
import pillModel from "../../assets/hero/pill.glb?url";
import Button from "../ui/Button.astro";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  heading: string;
  subheading: string;
  /** Rendered solid, first — the heavier of the two actions. */
  primaryCta: Cta;
  /** Rendered outlined, second. */
  secondaryCta: Cta;
}

const { heading, subheading, primaryCta, secondaryCta } = Astro.props;
---

<section class="hero relative h-dvh w-full overflow-hidden">
  {/* Instant plate — paints before three.js boots. */}
  <div
    class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat"
    style={`background-image:url(${heroBg.src})`}
  >
  </div>

  <canvas
    id="pill-canvas"
    class="absolute inset-0 z-[1] block opacity-0 transition-opacity duration-[550ms] ease-out"
    data-bg={heroBg.src}
    data-model={pillModel}
    aria-hidden="true"
  ></canvas>

  {/* Legibility scrim so the copy reads cleanly over the plate. */}
  <div
    class="pointer-events-none absolute inset-0 z-[2]"
    style="background:linear-gradient(to bottom,rgba(0,0,0,0.72) 0%,rgba(0,0,0,0.45) 26%,rgba(0,0,0,0.12) 42%,rgba(0,0,0,0) 55%)"
  >
  </div>

  <div class="hero-copy absolute left-1/2 top-0 z-10 w-[min(92vw,780px)] -translate-x-1/2 pt-[15.5vh] text-center">
    <h1 class="text-[length:var(--text-display-xl)] text-chalk">{heading}</h1>

    <p
      class="mx-auto mt-[clamp(14px,1.9vh,24px)] max-w-[30em] text-[clamp(12px,1.02vw,16px)] leading-[1.62] text-content-muted"
    >
      {subheading}
    </p>

    <div class="mt-[clamp(24px,3.8vh,46px)] flex flex-wrap items-center justify-center gap-4">
      <Button href={primaryCta.href} variant="primary" size="lg">
        {primaryCta.label}
      </Button>
      <Button href={secondaryCta.href} variant="ghost" size="lg">
        {secondaryCta.label}
      </Button>
    </div>
  </div>
</section>

<style>
  /* Copy is held back so it reveals together with the scene rather than
     appearing first. The scene's own 3s timeout guarantees it always shows. */
  .hero-copy {
    opacity: 0;
    transition: opacity 0.7s ease 0.12s;
  }

  :global(body.hero-ready) #pill-canvas,
  :global(body.hero-ready) .hero-copy {
    opacity: 1;
  }

  @media (max-width: 820px) {
    .hero-copy {
      /* The vertical nav now lives permanently in the top-left corner (no
         collapse behind a toggle any more), so this has to clear its full
         stacked height, not just the old single logo row. A vh-only value
         shrinks away on short devices and lets the two collide — the fixed
         floor guarantees clearance regardless of viewport height. */
      padding-top: max(13vh, 210px);
    }
  }
</style>

<script>
  import { initPillScene } from "./pill-scene";

  let teardown: (() => void) | null = null;

  async function initHero() {
    const canvas = document.getElementById("pill-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    const { bg, model } = canvas.dataset;
    if (!bg || !model) return;

    const reveal = () => document.body.classList.add("hero-ready");

    // If WebGL is unavailable, the CSS plate and scrim still carry the hero —
    // just show the copy and skip the 3D entirely.
    if (!window.WebGLRenderingContext) {
      reveal();
      return;
    }

    try {
      teardown = initPillScene({
        canvas,
        backgroundUrl: bg,
        modelUrl: model,
        onReady: reveal,
      });
    } catch (error) {
      console.error("[hero] scene init failed:", error);
      reveal();
    }
  }

  function destroyHero() {
    teardown?.();
    teardown = null;
    document.body.classList.remove("hero-ready");
  }

  initHero();
  // Client-side navigation: tear the old scene down before building a new one.
  document.addEventListener("astro:before-swap", destroyHero);
  document.addEventListener("astro:page-load", initHero);
</script>
