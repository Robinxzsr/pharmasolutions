---
/**
 * Scene — a full-bleed illustrated band.
 *
 * This is the structural backbone of the design language: the page is a
 * vertical stack of edge-to-edge painted bands (sky, ridgeline, village,
 * field) that butt directly against one another, with content floating on
 * top. A Scene owns one band.
 *
 * Layers are supplied as <SceneLayer> children in the `layers` slot and
 * paint back-to-front; page content goes in the default slot and always sits
 * above them.
 */
interface Props {
  /**
   * Background wash behind the artwork. Layer PNGs are transparent, so this
   * is what shows through the sky and between elements.
   */
  ground?: "sky" | "field" | "cream" | "ridge" | "none";
  /**
   * Vertical size. `full` is for hero bands; `band` for mid-page sections
   * that carry artwork; `auto` hugs its content.
   */
  height?: "full" | "band" | "auto";
  /** Adds the painterly noise overlay. On by default — it unifies the art. */
  grain?: boolean;
  /** Where content sits within the band. */
  align?: "start" | "center" | "end";
  class?: string;
}

const {
  ground = "none",
  height = "auto",
  grain = true,
  align = "center",
  class: className = "",
} = Astro.props;

const groundClass = {
  sky: "bg-sky-300",
  field: "bg-field-400",
  cream: "bg-cream-50",
  ridge: "bg-ridge-600",
  none: "",
}[ground];

const heightClass = {
  full: "min-h-dvh",
  band: "min-h-[70vh]",
  auto: "",
}[height];

const alignClass = {
  start: "justify-start",
  center: "justify-center",
  end: "justify-end",
}[align];
---

<section
  class:list={[
    "relative isolate flex w-full flex-col overflow-hidden",
    groundClass,
    heightClass,
    alignClass,
    grain && "grain",
    className,
  ]}
>
  {/* Painted layers — absolutely positioned, back to front. */}
  <slot name="layers" />

  {/* Content plane. Always above every layer. */}
  <div class="relative z-[var(--z-scene-content)] w-full">
    <slot />
  </div>
</section>
