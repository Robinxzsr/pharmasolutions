---
/**
 * SceneLayer — one painted plane inside a <Scene>.
 *
 * Handles the two things every layer in this style needs: correct stacking
 * relative to the other planes, and optional parallax drift so the bands
 * separate as the page scrolls.
 *
 * The image is passed as an imported asset (not a raw path) so Astro emits
 * AVIF/WebP at the right widths. Layers are decorative, so alt is always "".
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  /**
   * Depth plane. Determines z-index and the default parallax rate —
   * distant layers move less, which is what sells the depth.
   */
  depth: "sky" | "far" | "mid" | "near";
  /** Where the layer anchors. Ridgelines and fields anchor to the bottom. */
  anchor?: "top" | "bottom" | "cover";
  /**
   * Parallax multiplier override. 0 pins the layer; 1 scrolls with the page.
   * Leave unset to use the depth default.
   */
  speed?: number;
  class?: string;
}

const { src, depth, anchor = "bottom", speed, class: className = "" } = Astro.props;

/** Distant planes drift least. Tuned to read as depth, not as sliding. */
const depthDefaults = {
  sky: { z: "var(--z-scene-sky)", speed: 0.04 },
  far: { z: "var(--z-scene-far)", speed: 0.1 },
  mid: { z: "var(--z-scene-mid)", speed: 0.2 },
  near: { z: "var(--z-scene-near)", speed: 0.34 },
} as const;

const plane = depthDefaults[depth];
const rate = speed ?? plane.speed;

const anchorClass = {
  top: "top-0 object-top",
  bottom: "bottom-0 object-bottom",
  cover: "inset-0 object-center",
}[anchor];
---

<div
  class:list={["pointer-events-none absolute inset-x-0", anchorClass, className]}
  style={`z-index:${plane.z}`}
  data-scene-layer
  data-parallax-rate={rate}
>
  <Image
    src={src}
    alt=""
    aria-hidden="true"
    loading={depth === "sky" || depth === "far" ? "eager" : "lazy"}
    decoding="async"
    class:list={["w-full select-none", anchorClass]}
  />
</div>

<script>
  /**
   * Parallax driver.
   *
   * One shared IntersectionObserver + rAF loop for every layer on the page,
   * rather than a scroll listener per layer. Bails out entirely under
   * reduced-motion, leaving the layers in their painted resting position.
   */
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function initParallax() {
    if (reduceMotion.matches) return;

    const layers = Array.from(
      document.querySelectorAll<HTMLElement>("[data-scene-layer]")
    );
    if (layers.length === 0) return;

    const visible = new Set<HTMLElement>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          entry.isIntersecting ? visible.add(el) : visible.delete(el);
        }
      },
      { rootMargin: "20% 0px" }
    );
    layers.forEach((layer) => io.observe(layer));

    let ticking = false;

    function update() {
      ticking = false;
      const viewportCentre = window.innerHeight / 2;

      for (const layer of visible) {
        const rate = Number(layer.dataset.parallaxRate ?? 0);
        const rect = layer.getBoundingClientRect();
        // Offset from viewport centre drives the drift, so each layer is
        // neutral when centred and displaces symmetrically either side.
        const offset = (rect.top + rect.height / 2 - viewportCentre) * rate;
        layer.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0)`;
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  initParallax();
  // Re-init after client-side navigation.
  document.addEventListener("astro:page-load", initParallax);
</script>
