---
/**
 * Button — renders as <a> when given an href, otherwise <button>.
 *
 * Pills everywhere, matching the hero. `primary` is the white capsule from
 * the prototype's CTA; `glow` is the violet variant for moments that should
 * sit in the same light as the pill.
 */
interface Props {
  href?: string;
  variant?: "primary" | "glow" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const base =
  "inline-flex items-center justify-center gap-[11px] rounded-pill leading-none " +
  "transition-[background-color,color,opacity,box-shadow] duration-[var(--duration-ui)] " +
  "ease-[var(--ease-out-soft)] disabled:pointer-events-none disabled:opacity-50";

/* NeueBit is the only true bold face available — Mondwest would be
   synthesised (faux) bold, which smears a pixel typeface. */
const variantClass = {
  primary: "font-display font-bold bg-chalk text-void-950 hover:opacity-[0.88]",
  glow: "font-display font-bold bg-violet-500 text-chalk shadow-[var(--shadow-glow-sm)] hover:bg-violet-400",
  ghost: "font-body border border-border text-content hover:bg-glass",
}[variant];

const sizeClass = {
  sm: "px-6 py-3 text-[length:var(--text-ui)]",
  md: "px-8 py-3.5 text-[clamp(14px,1.15vw,18px)]",
  lg: "px-10 py-[18px] text-[clamp(17px,1.45vw,23px)]",
}[size];
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[base, variantClass, sizeClass, className]}
  {...rest}
>
  <slot />
</Tag>
