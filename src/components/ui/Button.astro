---
/**
 * Button — renders as <a> when given an href, otherwise <button>.
 *
 * The reference design uses fully-rounded pills throughout, so `--radius-pill`
 * is the only shape here. Variants map to the semantic colour tokens.
 */
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const base =
  "inline-flex items-center justify-center gap-2 rounded-pill font-medium " +
  "transition-[background-color,color,transform] duration-[var(--duration-ui)] " +
  "ease-[var(--ease-out-soft)] motion-safe:active:scale-[0.98] " +
  "disabled:pointer-events-none disabled:opacity-50";

const variantClass = {
  primary: "bg-ink-900 text-cream-50 hover:bg-ink-700",
  secondary: "bg-field-400 text-ink-900 hover:bg-field-300",
  ghost: "border border-current/25 text-current hover:bg-current/5",
}[variant];

const sizeClass = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg",
}[size];
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[base, variantClass, sizeClass, className]}
  {...rest}
>
  <slot />
</Tag>
