---
/**
 * Button — renders as <a> when given an href, otherwise <button>.
 *
 * A plain rectangle: flat fill, 1px border, square corners.
 *
 * Every variant INVERTS on hover rather than merely tinting. That is the
 * move the reference sites use, and it is the reason their buttons feel
 * decisive: the control doesn't warm up by 8%, it commits to a different
 * state. Each variant inverts toward a different member of the three-colour
 * palette, so the three of them stay distinguishable while hovered:
 *
 *   primary  white slab      ->  blue fill, white label
 *   glow     blue slab       ->  white fill, blue label
 *   ghost    outline only    ->  white fill, black label
 *
 * All three also take the bloom (`--shadow-glow-sm`), so the light behind a
 * pressed-looking control is the same light the hero pill throws. Timing is
 * --duration-ui, fast enough to read as a response rather than an animation;
 * sustained motion on this site belongs to cards (`shine`) alone.
 *
 * Labels are uppercase and widely tracked — the CTA treatment from the
 * reference material, and the same voice as the `label` utility so a button
 * and a card tag read as the same system.
 */
interface Props {
  href?: string;
  variant?: "primary" | "glow" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const base =
  "lift inline-flex items-center justify-center gap-[11px] leading-none border " +
  "font-display font-bold uppercase tracking-[0.1em] disabled:pointer-events-none disabled:opacity-50";

/* `glow` is the one variant lit at rest as well as on hover — the standing
   bloom is what marks it as the single primary action on a page (enrol,
   checkout). Its hover therefore has to be a genuine inversion rather than
   "more glow", or there'd be nowhere left for it to go. */
const variantClass = {
  primary:
    "border-chalk bg-chalk text-void-950 " +
    "hover:border-blue-500 hover:bg-blue-500 hover:text-chalk " +
    "focus-visible:border-blue-500 focus-visible:bg-blue-500 focus-visible:text-chalk",
  glow:
    "border-blue-500 bg-blue-500 text-chalk shadow-[var(--shadow-glow-sm)] " +
    "hover:border-chalk hover:bg-chalk hover:text-blue-600 hover:shadow-[var(--shadow-glow-lg)] " +
    "focus-visible:border-chalk focus-visible:bg-chalk focus-visible:text-blue-600 focus-visible:shadow-[var(--shadow-glow-lg)]",
  ghost:
    "border-chalk/35 bg-transparent text-chalk " +
    "hover:border-chalk hover:bg-chalk hover:text-void-950 " +
    "focus-visible:border-chalk focus-visible:bg-chalk focus-visible:text-void-950",
}[variant];

const sizeClass = {
  sm: "px-6 py-3 text-[length:var(--text-ui)]",
  md: "px-8 py-3.5 text-[clamp(14px,1.15vw,18px)]",
  lg: "px-10 py-[18px] text-[clamp(17px,1.45vw,23px)]",
}[size];
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[base, variantClass, sizeClass, className]}
  {...rest}
>
  <slot />
</Tag>
