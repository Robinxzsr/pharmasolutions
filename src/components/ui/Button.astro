---
/**
 * Button — renders as <a> when given an href, otherwise <button>.
 *
 * A plain rectangle: flat fill, 1.5px border, square corners — no radius, no
 * clip-path. Hover is `glow-hover` (see global.css): the border lifts a
 * shade and the site's own violet bloom (`--shadow-glow-sm`) appears behind
 * the box, the same accent language the hero pill already uses, so every
 * "press this" on the site sits in one light instead of each control
 * inventing its own.
 *
 * Labels are set uppercase with a touch of tracking — the small-caps-style
 * treatment most CTA buttons use, distinct from the display type's own
 * tracking (which stays tight; this is a different axis, applied to a
 * short, all-caps label rather than a sentence).
 */
interface Props {
  href?: string;
  variant?: "primary" | "glow" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const base =
  "inline-flex items-center justify-center gap-[11px] leading-none transition-[background-color,border-color,opacity,box-shadow] " +
  "duration-[var(--duration-ui)] ease-[var(--ease-out-soft)] font-display font-bold uppercase tracking-[0.04em] border " +
  "disabled:pointer-events-none disabled:opacity-50";

/* NeueBit is the only true bold face available — Mondwest would be
   synthesised (faux) bold, which smears a pixel typeface.

   `glow` is the one variant that glows at rest, not just on hover — the
   permanent bloom is what marks it as the primary action on a page (enrol,
   checkout), and hover just steps the whole thing up a shade brighter and
   the blur wider (`--shadow-glow-lg` in place of `-sm`), rather than using
   the shared `glow-hover` utility, which would fight this variant's own
   always-on shadow for which one wins on hover. */
const variantClass = {
  primary: "glow-hover border-transparent bg-chalk text-void-950 hover:opacity-[0.88]",
  glow:
    "border-transparent bg-violet-500 text-chalk shadow-[var(--shadow-glow-sm)] " +
    "hover:bg-violet-400 hover:shadow-[var(--shadow-glow-lg)] focus-visible:bg-violet-400 focus-visible:shadow-[var(--shadow-glow-lg)]",
  ghost: "glow-hover border-chalk/30 bg-transparent text-chalk hover:border-chalk/55 hover:bg-white/[0.08]",
}[variant];

const sizeClass = {
  sm: "px-6 py-3 text-[length:var(--text-ui)]",
  md: "px-8 py-3.5 text-[clamp(14px,1.15vw,18px)]",
  lg: "px-10 py-[18px] text-[clamp(17px,1.45vw,23px)]",
}[size];
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[base, variantClass, sizeClass, className]}
  {...rest}
>
  <slot />
</Tag>
