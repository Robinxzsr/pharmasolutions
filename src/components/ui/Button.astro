---
/**
 * Button — renders as <a> when given an href, otherwise <button>.
 *
 * Cut from the `bitmap` material (see global.css), not the hero pill's glass:
 * corners resolve on the pixel grid instead of a radius. The REST state is
 * the bitmap material; the HOVER state is deliberately the original,
 * un-halftoned interaction — a plain opacity fade on `primary`, a plain
 * colour shift on `glow`/`ghost` — because a growing dot screen on every
 * hover across the whole site turned out to be a lot of buzzing motion for
 * very little payoff. Card hover (ProtocolCard, BlogCard) is the one place
 * that halftone-grow move survives, since there it's revealing a cover image
 * rather than decorating a label.
 */
interface Props {
  href?: string;
  variant?: "primary" | "glow" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const base =
  "bitmap group/btn inline-flex items-center justify-center gap-[11px] leading-none " +
  "font-display font-bold transition-opacity duration-[var(--duration-ui)] " +
  "disabled:pointer-events-none disabled:opacity-50";

/* NeueBit is the only true bold face available — Mondwest would be
   synthesised (faux) bold, which smears a pixel typeface. */
const variantClass = {
  /* Original hover was a flat opacity fade — kept verbatim. */
  primary:
    "text-void-950 [--bitmap-ink:var(--color-chalk)] [--bitmap-fill:var(--color-chalk)] " +
    "hover:opacity-[0.88] focus-visible:opacity-[0.88]",
  /* Original hover lightened the fill from violet-500 to violet-400; the
     bitmap fill can't be transitioned as a flat colour swap the way a
     Tailwind bg-* class was, so this lightens the ink to the same step
     instead — same "one shade brighter" read, no dot growth. */
  glow:
    "text-chalk [--bitmap-ink:var(--color-violet-500)] [--bitmap-fill:var(--color-violet-500)] " +
    "hover:[--bitmap-ink:var(--color-violet-400)] focus-visible:[--bitmap-ink:var(--color-violet-400)]",
  /* The fill is a low-alpha black, not fully transparent: the ink is painted
     by the element itself and the fill layer is what covers it, so a truly
     transparent fill lets the ink flood the whole face instead of leaving a
     1px frame. It earns its keep besides — ghost is the variant that sits over
     the hero's bloom, where white type on bare violet is the weakest contrast
     on the site, and the wash gives the label a floor. Over the black pages it
     is invisible, so ghost still reads as outline-only everywhere else.
     Original hover lightened the border to chalk/55 and washed in a faint
     white fill — reproduced here as the ink lightening and the fill tinting
     toward white instead of black. */
  ghost:
    "text-chalk [--bitmap-ink:rgb(255_255_255/0.3)] [--bitmap-fill:rgb(0_0_0/0.35)] " +
    "hover:[--bitmap-ink:rgb(255_255_255/0.55)] hover:[--bitmap-fill:rgb(255_255_255/0.08)] " +
    "focus-visible:[--bitmap-ink:rgb(255_255_255/0.55)] focus-visible:[--bitmap-fill:rgb(255_255_255/0.08)]",
}[variant];

const sizeClass = {
  sm: "px-6 py-3 text-[length:var(--text-ui)]",
  md: "px-8 py-3.5 text-[clamp(14px,1.15vw,18px)]",
  lg: "px-10 py-[18px] text-[clamp(17px,1.45vw,23px)]",
}[size];
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[base, variantClass, sizeClass, className]}
  {...rest}
>
  <slot />
</Tag>
