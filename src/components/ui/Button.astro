---
/**
 * Button — renders as <a> when given an href, otherwise <button>.
 *
 * Cut from the `bitmap` material (see global.css), not the hero pill's glass:
 * corners resolve on the pixel grid, and hover is carried by the halftone
 * screen rather than by a glow. At rest every variant is a clean flat slab;
 * on hover a dot screen prints onto its face and the ink edge lights. That is
 * how tone works on the hero plate — same dots, printed fatter — so the
 * control reads as part of the same plate instead of hovering above it.
 *
 * Dot colour is chosen per variant so the screen always moves contrast the
 * safe way. On the white slab the dots are black and on violet they are black
 * too: the field screens *down* under light text, so the label gets more
 * contrast as the button lights up, never less. `ghost` screens up in violet
 * rather than white for the same reason — a growing white screen behind white
 * type is the one combination that loses legibility.
 */
interface Props {
  href?: string;
  variant?: "primary" | "glow" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const base =
  "bitmap group/btn inline-flex items-center justify-center gap-[11px] leading-none " +
  "font-display font-bold disabled:pointer-events-none disabled:opacity-50 " +
  /* Dots only ever grow on a pointer that can actually hover; on touch the
     rest state is the whole story and a stuck hover would be a lie. */
  "hover:[--dot-r:0.95px] focus-visible:[--dot-r:0.95px]";

/* NeueBit is the only true bold face available — Mondwest would be
   synthesised (faux) bold, which smears a pixel typeface. */
const variantClass = {
  primary:
    "text-void-950 [--bitmap-ink:var(--color-chalk)] [--bitmap-fill:var(--color-chalk)] " +
    "[--bitmap-dot:var(--color-void-950)]",
  glow:
    "text-chalk [--bitmap-ink:var(--color-violet-500)] [--bitmap-fill:var(--color-violet-500)] " +
    "[--bitmap-dot:var(--color-void-950)] hover:[--bitmap-ink:var(--color-violet-300)] " +
    "focus-visible:[--bitmap-ink:var(--color-violet-300)]",
  /* The fill is a low-alpha black, not fully transparent: the ink is painted
     by the element itself and the fill layer is what covers it, so a truly
     transparent fill lets the ink flood the whole face instead of leaving a
     1px frame. It earns its keep besides — ghost is the variant that sits over
     the hero's bloom, where white type on bare violet is the weakest contrast
     on the site, and the wash gives the label a floor. Over the black pages it
     is invisible, so ghost still reads as outline-only everywhere else. */
  ghost:
    "text-chalk [--bitmap-ink:rgb(255_255_255/0.3)] [--bitmap-fill:rgb(0_0_0/0.35)] " +
    "[--bitmap-dot:var(--color-violet-500)] hover:[--bitmap-ink:var(--color-chalk)] " +
    "focus-visible:[--bitmap-ink:var(--color-chalk)]",
}[variant];

const sizeClass = {
  sm: "px-6 py-3 text-[length:var(--text-ui)]",
  md: "px-8 py-3.5 text-[clamp(14px,1.15vw,18px)]",
  lg: "px-10 py-[18px] text-[clamp(17px,1.45vw,23px)]",
}[size];
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[base, variantClass, sizeClass, className]}
  {...rest}
>
  <slot />
</Tag>
