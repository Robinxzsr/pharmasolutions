---
/**
 * CoverPlaceholder — stand-in cover art for anything shown as a cover-image
 * card (protocols, blog posts) that has no `cover` image yet. A flat surface
 * tone plus a plain image glyph — not a fake illustration, just an honest
 * "art goes here" marker until real covers exist. Shared between
 * ProtocolCard and BlogCard so both fall back the same way.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class:list={["flex items-center justify-center bg-void-800", className]}>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-9 text-content-faint">
    <rect x="3" y="4" width="18" height="16" stroke="currentColor" stroke-width="1.5"></rect>
    <circle cx="9" cy="10" r="1.75" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="m5 17 5-5 3.5 3.5L18 11l1 1.5V18a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  </svg>
</div>
