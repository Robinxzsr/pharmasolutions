---
/**
 * Section — a page band.
 *
 * Replaces the illustrated-Scene primitive from the earlier direction. On a
 * black ground there is no painted artwork to stack, so a band is just a
 * ground tone and vertical rhythm — no ambient background wash. A radial
 * blue haze behind every masthead and the footer used to live here; it
 * read as decoration repeating across the site rather than as the hero's
 * own bloom, so it's gone. The hero keeps its glow; sections are flat.
 */
interface Props {
  /** `void` is the site ground; `raised` lifts a band slightly out of it. */
  ground?: "void" | "raised";
  /** Vertical padding. */
  space?: "sm" | "md" | "lg";
  /** Hairline rule along the upper edge. */
  divider?: boolean;
  id?: string;
  class?: string;
}

const { ground = "void", space = "lg", divider = false, id, class: className = "" } = Astro.props;

const groundClass = {
  void: "bg-surface",
  raised: "bg-surface-raised",
}[ground];

const spaceClass = {
  sm: "py-16",
  md: "py-24",
  lg: "py-32",
}[space];
---

<section
  id={id}
  class:list={["relative isolate w-full", groundClass, spaceClass, divider && "border-t border-border", className]}
>
  <slot />
</section>
