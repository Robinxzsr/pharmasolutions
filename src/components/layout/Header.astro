---
/**
 * Header — logo scrolls away with the page; the nav list below it stays
 * pinned to the viewport.
 *
 * No JS at all: the arrow-in / label-shift hover state (and its
 * focus-visible equivalent, for keyboard users) is pure CSS transform +
 * opacity on a named group. Always fully transparent — no background, no
 * scroll-triggered state to track.
 *
 * Nav links are set in NeueBit rather than bold Mondwest: Mondwest has no
 * true bold weight, so asking for it synthesises (faux-bolds) the face,
 * which smears a pixel typeface. NeueBit is the only face here with a real
 * bold cut — the same reasoning Button.astro uses for its label. The logo
 * stays on its original face/weight (Mondwest, normal) — bolding it read as
 * a size increase even though the metrics are within a few percent.
 *
 * The logo's font-size intentionally matches the nav links' clamp() exactly
 * (same min/preferred/max) rather than keeping its old, much smaller scale —
 * at the old size it read as visibly undersized next to the big bold list
 * beneath it. Same physical scale, different weight, is what actually
 * creates hierarchy here: the wordmark stays quiet through weight alone
 * rather than through being conspicuously smaller too.
 *
 * `items-start` on the <ul> below is load-bearing, not decorative: a flex
 * item's outer display blockifies (an `inline-block` child silently
 * computes to `block`), and the container's default `align-items: stretch`
 * then stretches every child link to the column's full width. Invisible
 * with left-aligned text, but real: it enlarges each link's actual hit
 * target (and hover trigger) to span almost the entire header row, so
 * hovering empty space far to the right of "Protocols" was lighting it up.
 * The logo itself no longer sits in a flex container at all (see below), so
 * it doesn't need the same guard — `inline-block` on a plain block sibling
 * genuinely shrink-wraps, none of that blockification applies.
 *
 * Only <nav> is `position: fixed`; the logo stays on the header's
 * `absolute` (document-anchored, so it scrolls away with the page — just
 * without occupying layout space, which is what keeps the hero flush
 * against the top of the viewport). <nav> deliberately sets no top/left of
 * its own: a fixed element with `inset: auto` keeps its "static position" —
 * where it would have landed in normal flow — so it lands exactly below the
 * logo with no manual offset math, then simply stays there once the page
 * scrolls out from under it.
 *
 * That only works because the logo and <nav> are plain block siblings, NOT
 * flex items: for an out-of-flow child of a FLEX container specifically,
 * the spec has it compute its static position as if it were the container's
 * only child, ignoring any actual preceding sibling — confirmed by
 * measuring it, nav landed exactly on top of the logo instead of below it.
 * Plain block flow doesn't have that carve-out, so switching to it (logo:
 * `block`, spaced by its own `mb-0.5` instead of a flex `gap`) is what
 * makes nav's static position honour the logo's real height.
 */
import { primaryNav, site } from "../../lib/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="absolute inset-x-0 top-0 z-40 px-[18px] py-4 md:px-[34px] md:py-[22px]">
  <a
    href="/"
    class="mb-0.5 inline-block text-[clamp(22px,2.6vw,34px)] leading-none tracking-[-0.01em] text-chalk"
  >
    {site.name}
  </a>

  <nav aria-label="Primary" class="fixed z-50">
    <ul class="flex flex-col items-start gap-0.5">
      {
        primaryNav.map((link) => {
          const active = isActive(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "group/nav flex items-center gap-2 py-1 font-display text-[clamp(22px,2.6vw,34px)]",
                  "font-bold leading-[1.15] transition-colors duration-300 ease-out",
                  "hover:text-brand-soft focus-visible:text-brand-soft",
                  active ? "text-brand-soft" : "text-content-muted",
                ]}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  class:list={[
                    "size-[0.72em] shrink-0 transition-[transform,opacity] duration-300 ease-out",
                    "group-hover/nav:translate-x-0 group-hover/nav:opacity-100",
                    "group-focus-visible/nav:translate-x-0 group-focus-visible/nav:opacity-100",
                    active ? "translate-x-0 opacity-100" : "-translate-x-full opacity-0",
                  ]}
                >
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>

                <span
                  class:list={[
                    "inline-block transition-transform duration-300 ease-out",
                    "group-hover/nav:translate-x-0 group-focus-visible/nav:translate-x-0",
                    active ? "translate-x-0" : "-translate-x-8",
                  ]}
                >
                  {link.label}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
