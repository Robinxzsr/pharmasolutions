---
/**
 * Header — logo top-left, with the primary nav stacked vertically beneath it.
 *
 * No JS: the arrow-in / label-shift hover state (and its focus-visible
 * equivalent, for keyboard users) is pure CSS transform + opacity on a
 * named group, so this whole component ships zero client script. A vertical
 * list of three items never needs a collapse breakpoint either, so unlike
 * the old horizontal bar there is no mobile toggle to maintain.
 *
 * Nav links are set in NeueBit rather than bold Mondwest: Mondwest has no
 * true bold weight, so asking for it synthesises (faux-bolds) the face,
 * which smears a pixel typeface. NeueBit is the only face here with a real
 * bold cut — the same reasoning Button.astro uses for its label. The logo
 * stays on its original face/weight (Mondwest, normal) — bolding it read as
 * a size increase even though the metrics are within a few percent.
 *
 * The logo's font-size intentionally matches the nav links' clamp() exactly
 * (same min/preferred/max) rather than keeping its old, much smaller scale —
 * at the old size it read as visibly undersized next to the big bold list
 * beneath it. Same physical scale, different weight, is what actually
 * creates hierarchy here: the wordmark stays quiet through weight alone
 * rather than through being conspicuously smaller too.
 *
 * `items-start` on both flex columns (this one and the <ul> below) is load-
 * bearing, not decorative: a flex item's outer display blockifies (an
 * `inline-block` child silently computes to `block`), and the container's
 * default `align-items: stretch` then stretches every child — logo and nav
 * links alike — to the column's full width. Invisible with left-aligned
 * text, but real: it enlarges each link's actual hit target (and hover
 * trigger) to span almost the entire header row, so hovering empty space
 * far to the right of "Protocols" was lighting it up.
 *
 * Logo-to-first-link spacing and inter-link spacing share one `gap-0.5`
 * value rather than a hand-matched margin, so they can't drift apart again:
 * the logo and the <nav> are both flex children of the same column, and the
 * <ul> inside <nav> uses the identical gap.
 *
 * `position: fixed` (not `absolute`) is what makes this sticky: absolute
 * anchors to the document, so it scrolled away with the page like any other
 * element. Fixed pins it to the viewport instead.
 *
 * It stays fully transparent at the top of the page — that's what lets it
 * float over the hero art unframed — and only gains the glass backdrop once
 * scrolled, so it stays legible over arbitrary page content instead of
 * floating bare text on top of it with no separation.
 */
import { primaryNav, site } from "../../lib/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header
  data-sticky-header
  class:list={[
    "fixed inset-x-0 top-0 z-50 px-[18px] py-4 md:px-[34px] md:py-[22px]",
    "border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300 ease-out",
    "data-[scrolled]:bg-surface-glass data-[scrolled]:border-border data-[scrolled]:backdrop-blur-md",
  ]}
>
  <div class="flex flex-col items-start gap-0.5">
    <a
      href="/"
      class="text-[clamp(22px,2.6vw,34px)] leading-none tracking-[-0.01em] text-chalk"
    >
      {site.name}
    </a>

    <nav aria-label="Primary">
      <ul class="flex flex-col items-start gap-0.5">
        {
          primaryNav.map((link) => {
            const active = isActive(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "group/nav flex items-center gap-2 py-1 font-display text-[clamp(22px,2.6vw,34px)]",
                    "font-bold leading-[1.15] transition-colors duration-300 ease-out",
                    "hover:text-brand-soft focus-visible:text-brand-soft",
                    active ? "text-brand-soft" : "text-content-muted",
                  ]}
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                    class:list={[
                      "size-[0.72em] shrink-0 transition-[transform,opacity] duration-300 ease-out",
                      "group-hover/nav:translate-x-0 group-hover/nav:opacity-100",
                      "group-focus-visible/nav:translate-x-0 group-focus-visible/nav:opacity-100",
                      active ? "translate-x-0 opacity-100" : "-translate-x-full opacity-0",
                    ]}
                  >
                    <path
                      d="M5 12h14M13 6l6 6-6 6"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>

                  <span
                    class:list={[
                      "inline-block transition-transform duration-300 ease-out",
                      "group-hover/nav:translate-x-0 group-focus-visible/nav:translate-x-0",
                      active ? "translate-x-0" : "-translate-x-8",
                    ]}
                  >
                    {link.label}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  /**
   * Toggles the header's glass backdrop once the page has scrolled past a
   * small threshold. No ClientRouter/view-transitions is configured in this
   * project, so every navigation is a full page load — a plain listener
   * registered once per load is sufficient. The astro:page-load listener is
   * kept anyway, matching every other component's script in this codebase,
   * so nothing here needs revisiting if that ever changes.
   */
  function initStickyHeader() {
    const header = document.querySelector<HTMLElement>("[data-sticky-header]");
    if (!header || header.dataset.stickyBound) return;
    header.dataset.stickyBound = "true";

    const SCROLLED_THRESHOLD = 8;

    function update() {
      if (window.scrollY > SCROLLED_THRESHOLD) header!.setAttribute("data-scrolled", "");
      else header!.removeAttribute("data-scrolled");
    }

    update(); // Correct immediately for a page that loads already scrolled (e.g. a #hash link).
    window.addEventListener("scroll", update, { passive: true });
  }

  initStickyHeader();
  document.addEventListener("astro:page-load", initStickyHeader);
</script>
