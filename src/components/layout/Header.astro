---
/**
 * Header — logo top-left, nav below it. True sticky: both scroll normally
 * with the page at first; once <nav> would scroll past the top of the
 * viewport, it catches there and stays while the rest of the page keeps
 * moving underneath it. Scrolling back up releases it just as smoothly —
 * that's native `position: sticky`, not something built by hand, so there's
 * no synthetic toggle that could ever jump or flicker on the way back.
 *
 * No JS at all: neither the stick/release above, nor the arrow-in /
 * label-shift hover state (and its focus-visible equivalent, for keyboard
 * users), which is pure CSS transform + opacity on a named group. Always
 * fully transparent — no background, no scroll-triggered state to track.
 *
 * Nav links are set in NeueBit rather than bold Mondwest: Mondwest has no
 * true bold weight, so asking for it synthesises (faux-bolds) the face,
 * which smears a pixel typeface. NeueBit is the only face here with a real
 * bold cut — the same reasoning Button.astro uses for its label. The logo
 * stays on its original face/weight (Mondwest, normal) — bolding it read as
 * a size increase even though the metrics are within a few percent.
 *
 * The logo's font-size intentionally matches the nav links' clamp() exactly
 * (same min/preferred/max) rather than keeping its old, much smaller scale —
 * at the old size it read as visibly undersized next to the big bold list
 * beneath it. Same physical scale, different weight, is what actually
 * creates hierarchy here: the wordmark stays quiet through weight alone
 * rather than through being conspicuously smaller too.
 *
 * `items-start` on the <ul> below is load-bearing, not decorative: a flex
 * item's outer display blockifies (an `inline-block` child silently
 * computes to `block`), and the container's default `align-items: stretch`
 * then stretches every child link to the column's full width. Invisible
 * with left-aligned text, but real: it enlarges each link's actual hit
 * target (and hover trigger) to span almost the entire header row, so
 * hovering empty space far to the right of "Protocols" was lighting it up.
 *
 * For `<nav>` to genuinely scroll-then-stick, it has to be a real in-flow
 * element again — `position: sticky` on an out-of-flow ancestor does
 * nothing. BaseLayout puts this <header> and <main> in the same CSS grid
 * cell (both col/row-start-1) so header can overlay the top of the page
 * without needing to know its own height, which the fluid clamp()
 * typography here makes genuinely variable — a fixed negative-margin
 * overlap would drift at in-between viewport widths.
 *
 * <header> is left to take the grid default of stretching to the *height*
 * of that shared cell — i.e. main's full page height — rather than
 * collapsing to just its own content (logo + nav). That's not optional:
 * a sticky element can never remain stuck past the bottom edge of its own
 * containing block, so a header that collapsed to ~225px of content height
 * would release <nav> back into normal flow the moment the page scrolled
 * past that — confirmed by watching it happen. `pointer-events-none` on
 * header plus `pointer-events-auto` on just the logo and <nav> is what
 * makes a header that now spans the entire page safe: its own (invisible,
 * background-less) box can't intercept clicks meant for whatever's
 * underneath it outside the logo/nav column, at any scroll position.
 */
import { primaryNav, site } from "../../lib/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header
  class="pointer-events-none col-start-1 row-start-1 z-40 px-[18px] py-4 md:px-[34px] md:py-[22px]"
>
  <a
    href="/"
    class="pointer-events-auto mb-0.5 inline-block text-[clamp(22px,2.6vw,34px)] leading-none tracking-[-0.01em] text-chalk"
  >
    {site.name}
  </a>

  <nav aria-label="Primary" class="pointer-events-auto sticky top-0 z-50">
    <ul class="flex flex-col items-start gap-0.5">
      {
        primaryNav.map((link) => {
          const active = isActive(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "group/nav flex items-center gap-2 py-1 font-display text-[clamp(22px,2.6vw,34px)]",
                  "font-bold leading-[1.15] transition-colors duration-300 ease-out",
                  "hover:text-brand-soft focus-visible:text-brand-soft",
                  active ? "text-brand-soft" : "text-content-muted",
                ]}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  class:list={[
                    "size-[0.72em] shrink-0 transition-[transform,opacity] duration-300 ease-out",
                    "group-hover/nav:translate-x-0 group-hover/nav:opacity-100",
                    "group-focus-visible/nav:translate-x-0 group-focus-visible/nav:opacity-100",
                    active ? "translate-x-0 opacity-100" : "-translate-x-full opacity-0",
                  ]}
                >
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>

                <span
                  class:list={[
                    "inline-block transition-transform duration-300 ease-out",
                    "group-hover/nav:translate-x-0 group-focus-visible/nav:translate-x-0",
                    active ? "translate-x-0" : "-translate-x-8",
                  ]}
                >
                  {link.label}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
