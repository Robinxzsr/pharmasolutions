---
/**
 * Header — transparent overlay nav, floating over the hero.
 *
 * A 1fr / auto / 1fr grid rather than space-between: with flanking items of
 * different widths, space-between does NOT actually centre the middle item.
 */
import Button from "../ui/Button.astro";
import { primaryNav, site } from "../../lib/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const links = primaryNav.filter((l) => !l.primary);
const cta = primaryNav.find((l) => l.primary);
---

<header class="absolute inset-x-0 top-0 z-50">
  <nav
    class="grid grid-cols-[1fr_auto_1fr] items-center px-[18px] py-4 md:px-[34px] md:py-[22px]"
    aria-label="Primary"
  >
    <a
      href="/"
      class="justify-self-start text-[clamp(15px,1.35vw,21px)] leading-none tracking-[-0.01em] text-chalk"
    >
      {site.name}
    </a>

    <ul class="glass hidden items-center gap-0.5 justify-self-center rounded-pill px-[7px] py-[5px] md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class="inline-flex items-center justify-center whitespace-nowrap rounded-pill px-[17px] py-[9px] text-[length:var(--text-ui)] leading-none text-content-muted transition-[color,background] duration-[var(--duration-ui)] hover:bg-white/[0.09] hover:text-chalk aria-[current=page]:text-chalk"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3 justify-self-end">
      {cta && <Button href={cta.href} variant="primary" size="sm" class="font-body font-normal">{cta.label}</Button>}

      <button
        type="button"
        class="text-chalk md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="sr-only">Toggle menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-nav" hidden class="md:hidden">
    <ul class="flex flex-col gap-4 px-[18px] pb-8">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-lg text-chalk">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  function initMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = document.getElementById("mobile-nav");
    if (!toggle || !panel) return;

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      panel.hidden = open;
    });
  }

  initMenu();
  document.addEventListener("astro:page-load", initMenu);
</script>
