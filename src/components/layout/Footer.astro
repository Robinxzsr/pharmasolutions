---
/**
 * Footer — four nav columns over the void, with the newsletter capture
 * sitting on the flat page ground.
 */
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import NewsletterForm from "../forms/NewsletterForm.astro";
import { footerNav, socials, site } from "../../lib/site";

const year = new Date().getFullYear();
---

<footer>
  <Section space="md" divider>
    <Container width="wide">
      <div class="grid items-center gap-10 pb-20 md:grid-cols-2">
        <div>
          <h2 class="text-[length:var(--text-display-md)]">Stay in the loop</h2>
          <p class="mt-3 max-w-sm text-content-muted">
            Occasional notes on pharmacology, plus first access to new cohorts.
          </p>
        </div>
        <NewsletterForm class="max-w-md md:justify-self-end" />
      </div>

      <div class="grid gap-10 border-t border-border pt-16 md:grid-cols-[1.4fr_repeat(4,1fr)]">
        <div class="max-w-xs">
          <p class="text-[clamp(15px,1.35vw,21px)] text-chalk">{site.name}</p>
          <p class="mt-3 text-content-muted">{site.tagline}</p>

          <ul class="mt-6 flex gap-3">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    rel="me noopener"
                    class="lift grid size-10 place-items-center border border-border bg-void-900 text-content-muted hover:border-border-lit hover:bg-blue-500 hover:text-chalk focus-visible:border-border-lit focus-visible:bg-blue-500 focus-visible:text-chalk"
                  >
                    <span class="sr-only">{s.label}</span>
                    <span aria-hidden="true" class="label">
                      {s.label.slice(0, 2)}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {
          footerNav.map((group) => (
            <nav aria-label={group.heading}>
              <h3 class="text-[length:var(--text-display-sm)] text-chalk">{group.heading}</h3>
              <ul class="mt-4 flex flex-col gap-2.5">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-content-muted transition-colors hover:text-chalk"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>

      <div
        class="mt-16 flex flex-col gap-4 border-t border-border pt-6 text-sm text-content-faint sm:flex-row sm:items-center sm:justify-between"
      >
        <p>&copy; {year} {site.name}. All rights reserved.</p>
        <ul class="flex gap-6">
          <li><a href="/legal/privacy" class="hover:text-chalk">Privacy Policy</a></li>
          <li><a href="/legal/terms" class="hover:text-chalk">Terms of Service</a></li>
        </ul>
      </div>
    </Container>
  </Section>
</footer>
