---
/**
 * CoverPlaceholder — stand-in cover art for a protocol with no `cover` image
 * yet (currently: all of them). A wash of the hero's own violet echoed at
 * low intensity, plus a plain image glyph — not a fake illustration, just
 * an honest "art goes here" marker until real covers exist.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "relative isolate flex items-center justify-center overflow-hidden bg-void-800",
    className,
  ]}
>
  <div
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(ellipse 70% 55% at 50% 40%, rgb(124 77 255 / 0.16), transparent 72%)"
  >
  </div>

  <svg
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    class="relative size-9 text-content-faint"
  >
    <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
    <circle cx="9" cy="10" r="1.75" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="m5 17 5-5 3.5 3.5L18 11l1 1.5V18a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  </svg>
</div>
