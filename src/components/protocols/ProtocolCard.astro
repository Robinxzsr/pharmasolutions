---
/**
 * ProtocolCard — one shop-front tile: cover, name, price. The whole card is
 * the link, not a "view" button inside it — a shop tile should feel like one
 * clickable object, not a text block with a control bolted on.
 *
 * The corner arrow is the same glyph and reveal mechanic as the vertical
 * nav's hover state (same path, same translate-in), reused deliberately so
 * the two "hover reveals an arrow" moments on the site read as one system
 * rather than two different affordances that happen to look similar.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import CoverPlaceholder from "./CoverPlaceholder.astro";

interface Props {
  protocol: CollectionEntry<"protocols">;
}

const { protocol } = Astro.props;
const { name, summary, priceDisplay, cover, coverAlt } = protocol.data;
---

<a
  href={`/protocols/${protocol.id}`}
  class="group/card block overflow-hidden rounded-card border border-border bg-surface-raised transition-[border-color,box-shadow,transform] duration-300 ease-out hover:-translate-y-1 hover:border-violet-500/40 hover:shadow-[var(--shadow-glow-sm)] focus-visible:-translate-y-1 focus-visible:border-violet-500/40 focus-visible:shadow-[var(--shadow-glow-sm)]"
>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ""}
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
        class="aspect-[3/4] w-full object-cover"
      />
    ) : (
      <CoverPlaceholder class="aspect-[3/4] w-full" />
    )
  }

  <div class="flex items-start justify-between gap-3 p-5">
    <div>
      <h2 class="font-display text-lg font-bold leading-tight text-chalk">{name}</h2>
      <p class="mt-1.5 text-sm text-content-muted">{summary}</p>
      <p class="mt-3 font-display text-lg font-bold text-brand-soft">{priceDisplay}</p>
    </div>

    <svg
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      class="mt-1 size-5 shrink-0 -translate-x-2 text-content-faint opacity-0 transition-[transform,opacity,color] duration-300 ease-out group-hover/card:translate-x-0 group-hover/card:text-brand-soft group-hover/card:opacity-100 group-focus-visible/card:translate-x-0 group-focus-visible/card:text-brand-soft group-focus-visible/card:opacity-100"
    >
      <path
        d="M5 12h14M13 6l6 6-6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </div>
</a>
