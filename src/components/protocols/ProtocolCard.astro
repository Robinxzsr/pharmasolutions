---
/**
 * ProtocolCard — one shop-front tile: cover, name, summary, price. The whole
 * card is the link, not a "view" button inside it — a shop tile should feel
 * like one clickable object, not a text block with a control bolted on. (It
 * also keeps the markup free of a button nested inside an anchor.)
 *
 * The cover is 16:10, not portrait. A 3:4 cover made a 432x724px card at
 * desktop — too tall to fit even one full row on a 900px viewport. Landscape
 * covers plus tightened type bring it to roughly 344x325, so a full row and
 * the top of the next are both visible.
 *
 * The corner arrow is the same glyph and reveal mechanic as the vertical
 * nav's hover state (same four-rect pixel arrow, same translate-in), reused
 * deliberately so the two "hover reveals an arrow" moments on the site read
 * as one system rather than two different affordances that happen to look
 * similar. It's built from axis-aligned rects rather than a stroked path so
 * its edges stay as hard as the pixel display face's, instead of the smooth
 * rounded joins a generic icon stroke would carry. No `shape-rendering:
 * crispEdges` (see Header.astro for the measured reason) — it pixel-snaps
 * each rect independently and renders a visibly lopsided glyph at several
 * real sizes, since the icon is almost never shown at an exact multiple of
 * its 16-unit grid.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import CoverPlaceholder from "./CoverPlaceholder.astro";

interface Props {
  protocol: CollectionEntry<"protocols">;
}

const { protocol } = Astro.props;
const { name, summary, priceDisplay, cover, coverAlt } = protocol.data;
---

<a
  href={`/protocols/${protocol.id}`}
  class="group/card block overflow-hidden rounded-card border border-border bg-surface-raised transition-[border-color,box-shadow,transform] duration-300 ease-out hover:-translate-y-1 hover:border-violet-500/40 hover:shadow-[var(--shadow-glow-sm)] focus-visible:-translate-y-1 focus-visible:border-violet-500/40 focus-visible:shadow-[var(--shadow-glow-sm)]"
>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ""}
        widths={[320, 480, 720]}
        sizes="(min-width: 1024px) 344px, (min-width: 640px) 45vw, 90vw"
        class="aspect-[16/10] w-full object-cover"
      />
    ) : (
      <CoverPlaceholder class="aspect-[16/10] w-full" />
    )
  }

  <div class="flex items-start justify-between gap-3 p-4">
    <div class="min-w-0">
      <h2 class="font-display text-base font-bold leading-tight text-chalk">{name}</h2>
      <p class="mt-1 line-clamp-2 text-[13px] leading-snug text-content-muted">{summary}</p>
      <p class="mt-2.5 font-display text-base font-bold text-brand-soft">{priceDisplay}</p>
    </div>

    <svg
      viewBox="0 0 16 16"
      aria-hidden="true"
      class="mt-1 size-3.5 shrink-0 -translate-x-2 text-content-faint opacity-0 transition-[transform,opacity,color] duration-300 ease-out group-hover/card:translate-x-0 group-hover/card:text-brand-soft group-hover/card:opacity-100 group-focus-visible/card:translate-x-0 group-focus-visible/card:text-brand-soft group-focus-visible/card:opacity-100"
    >
      <rect x="1" y="6" width="8" height="4" fill="currentColor"></rect>
      <rect x="9" y="2" width="2" height="12" fill="currentColor"></rect>
      <rect x="11" y="4" width="2" height="8" fill="currentColor"></rect>
      <rect x="13" y="6" width="2" height="4" fill="currentColor"></rect>
    </svg>
  </div>
</a>
