---
/**
 * ProtocolCard — one shop-front tile: cover, name, summary, price. The whole
 * card is the link, not a "view" button inside it — a shop tile should feel
 * like one clickable object, not a text block with a control bolted on. The
 * "View protocol" pill below is a `<span>` styled as a button, not a real
 * one, so it stays a control-free child of that single anchor.
 *
 * The cover is 16:10, not portrait. A 3:4 cover made a 432x724px card at
 * desktop — too tall to fit even one full row on a 900px viewport. Landscape
 * covers plus tightened type bring it to roughly 344x325, so a full row and
 * the top of the next are both visible.
 *
 * Hover reveals the same three-part moment BlogCard uses on its own cover —
 * a slow image scale, a `halftone` dot screen printed onto the art via
 * `mix-blend-multiply`, and a centered CTA pill — so the two "cover art you
 * can click" moments on the site read as one system. See `halftone` in
 * global.css for why that replaces the site's usual `glass` blur here.
 *
 * The card's OUTER frame hover is `shine` (see global.css): a single white
 * streak travels once around the border while the card is hovered, rather
 * than a flat colour change — the site's one deliberately animated hover,
 * reserved for the one clickable "look at this" object on a page.
 *
 * The pill's arrow is the same four-rect pixel glyph as the nav's hover
 * arrow (see Header.astro), not the smooth rounded-stroke icon a generic
 * arrow-right would use — same reasoning: hard 90° corners read as one
 * system with the pixel display face, and a round stroke-linecap/linejoin
 * doesn't.
 *
 * The text block below the cover is a flex column with the price pushed
 * down by `mt-auto`: summary length varies protocol to protocol, and a grid
 * row already stretches every card to the tallest one in it, so without
 * this the price sits at a different height on every card in the row.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import CoverPlaceholder from "../ui/CoverPlaceholder.astro";

interface Props {
  protocol: CollectionEntry<"protocols">;
}

const { protocol } = Astro.props;
const { name, summary, priceDisplay, cover, coverAlt } = protocol.data;
---

<a
  href={`/protocols/${protocol.id}`}
  class="group/card shine flex h-full flex-col border border-border bg-surface-raised"
>
  <div class="relative shrink-0 overflow-hidden">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ""}
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 344px, (min-width: 640px) 45vw, 90vw"
          class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out group-hover/card:scale-105"
        />
      ) : (
        <CoverPlaceholder class="aspect-[16/10] w-full transition-transform duration-500 ease-out group-hover/card:scale-105" />
      )
    }

    {/* Halftone screen: dots multiply onto the cover's own tones instead of a flat tint sitting over it. */}
    <div
      class="halftone pointer-events-none absolute inset-0 opacity-0 mix-blend-multiply transition-opacity duration-300 ease-out group-hover/card:opacity-100 group-focus-visible/card:opacity-100"
    >
    </div>

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface/80 to-transparent opacity-0 transition-opacity duration-300 ease-out group-hover/card:opacity-100 group-focus-visible/card:opacity-100"
    >
    </div>

    <div
      class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 ease-out group-hover/card:opacity-100 group-focus-visible/card:opacity-100"
    >
      <span
        class="inline-flex items-center gap-2 border border-chalk bg-void-950/90 px-5 py-2.5 font-display text-sm font-bold uppercase tracking-[0.04em] text-chalk"
      >
        View protocol
        <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3.5 shrink-0 translate-y-[0.06em]">
          <rect x="1" y="6" width="8" height="4" fill="currentColor"></rect>
          <rect x="9" y="2" width="2" height="12" fill="currentColor"></rect>
          <rect x="11" y="4" width="2" height="8" fill="currentColor"></rect>
          <rect x="13" y="6" width="2" height="4" fill="currentColor"></rect>
        </svg>
      </span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h2 class="line-clamp-2 text-[length:var(--text-display-card)] text-chalk">{name}</h2>
    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-content-muted">{summary}</p>
    {/* mt-auto: pinned to the bottom of the flex column regardless of how
        much room the name and summary above took up. */}
    <p class="mt-auto pt-3 font-display text-lg font-bold text-brand-soft">{priceDisplay}</p>
  </div>
</a>
