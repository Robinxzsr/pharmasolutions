---
/**
 * NewsletterForm — the pill-shaped capture from the footer band.
 *
 * Posts to /api/newsletter with fetch, falling back to a normal form POST if
 * JS is unavailable. Status is announced via aria-live.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<form
  method="POST"
  action="/api/newsletter"
  data-newsletter-form
  class:list={["w-full", className]}
>
  <div
    class="glass flex items-center gap-2 rounded-pill p-1.5 pl-5"
  >
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      id="newsletter-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="Enter your email"
      class="w-full bg-transparent py-2.5 text-chalk placeholder:text-content-faint focus:outline-none"
    />

    {/* Honeypot — bots fill it, humans never see it. */}
    <input
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute h-0 w-0 overflow-hidden opacity-0"
    />

    <button
      type="submit"
      class="grid size-11 shrink-0 place-items-center rounded-pill bg-chalk text-void-950 transition-opacity duration-[var(--duration-ui)] hover:opacity-[0.88]"
    >
      <span class="sr-only">Subscribe</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M7 17 17 7M17 7H9m8 0v8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <p data-newsletter-status role="status" aria-live="polite" class="mt-2 min-h-5 px-5 text-sm"></p>
</form>

<script>
  function initNewsletter() {
    const forms = document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]");

    for (const form of forms) {
      if (form.dataset.bound) continue;
      form.dataset.bound = "true";

      const status = form.querySelector<HTMLElement>("[data-newsletter-status]");
      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!status || !submit) return;

        submit.disabled = true;
        status.textContent = "Subscribing…";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: new FormData(form),
          });
          const result = await response.json();

          status.textContent = response.ok
            ? "You're on the list."
            : (result.message ?? "Something went wrong. Try again.");

          if (response.ok) form.reset();
        } catch {
          status.textContent = "Network error. Try again.";
        } finally {
          submit.disabled = false;
        }
      });
    }
  }

  initNewsletter();
  document.addEventListener("astro:page-load", initNewsletter);
</script>
