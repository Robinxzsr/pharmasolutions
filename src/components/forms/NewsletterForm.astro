---
/**
 * NewsletterForm — the capture bar in the footer band.
 *
 * A plain bordered box, not the hero pill's glass — the footer is a solid
 * region of the page, and a frosted capsule there was borrowing a material
 * that only means something where it floats over the 3D pill. On focus the
 * border lifts to brand-soft and the standard soft violet glow appears
 * around the bar, the same feedback every field and button on the site now
 * gives.
 *
 * Posts to /api/newsletter with fetch, falling back to a normal form POST if
 * JS is unavailable. Status is announced via aria-live.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<form
  method="POST"
  action="/api/newsletter"
  data-newsletter-form
  class:list={["w-full", className]}
>
  <div
    class="flex items-center gap-2 border border-border bg-void-900 p-1.5 pl-5 transition-[border-color,box-shadow] duration-[var(--duration-ui)] ease-[var(--ease-out-soft)] focus-within:border-brand-soft focus-within:shadow-[var(--shadow-glow-sm)]"
  >
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      id="newsletter-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="Enter your email"
      class="w-full bg-transparent py-2.5 text-chalk placeholder:text-content-faint focus:outline-none"
    />

    {/* Honeypot — bots fill it, humans never see it. */}
    <input
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute h-0 w-0 overflow-hidden opacity-0"
    />

    {/* The house arrow, not a second one. This was a rounded-stroke diagonal
        — the only icon on the site drawn in a different hand from the nav and
        card glyphs. One icon system: four axis-aligned rects on a 16 grid.
        Hover is the original plain opacity fade, not the halftone grow. */}
    <button
      type="submit"
      class="grid size-11 shrink-0 place-items-center border border-transparent bg-chalk text-void-950 transition-opacity duration-[var(--duration-ui)] hover:opacity-[0.88] focus-visible:opacity-[0.88]"
    >
      <span class="sr-only">Subscribe</span>
      <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="1" y="6" width="8" height="4" fill="currentColor"></rect>
        <rect x="9" y="2" width="2" height="12" fill="currentColor"></rect>
        <rect x="11" y="4" width="2" height="8" fill="currentColor"></rect>
        <rect x="13" y="6" width="2" height="4" fill="currentColor"></rect>
      </svg>
    </button>
  </div>

  <p data-newsletter-status role="status" aria-live="polite" class="mt-2 min-h-5 px-5 text-sm"></p>
</form>

<script>
  function initNewsletter() {
    const forms = document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]");

    for (const form of forms) {
      if (form.dataset.bound) continue;
      form.dataset.bound = "true";

      const status = form.querySelector<HTMLElement>("[data-newsletter-status]");
      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!status || !submit) return;

        submit.disabled = true;
        status.textContent = "Subscribing…";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: new FormData(form),
          });
          const result = await response.json();

          status.textContent = response.ok
            ? "You're on the list."
            : (result.message ?? "Something went wrong. Try again.");

          if (response.ok) form.reset();
        } catch {
          status.textContent = "Network error. Try again.";
        } finally {
          submit.disabled = false;
        }
      });
    }
  }

  initNewsletter();
  document.addEventListener("astro:page-load", initNewsletter);
</script>
