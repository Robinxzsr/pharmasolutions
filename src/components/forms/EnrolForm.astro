---
/**
 * EnrolForm — the application capture.
 *
 * Posts to /api/enrol. Works without JS (standard form POST); with JS it
 * submits in place and swaps in a confirmation.
 */
import Button from "../ui/Button.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

/* The border/background live on a WRAPPER, not the control itself, so the
   focus state can react to `focus-within` — the whole field lights up, not
   just the text caret inside it. Border and shadow are the standard modern
   input-focus pair: the border steps up to brand-soft and a soft blurred
   glow (the same `--shadow-glow-sm` every other control uses) appears
   around the box, both transitioning smoothly rather than snapping. */
const shell =
  "mt-1.5 border border-border bg-surface-raised transition-[border-color,box-shadow] duration-[var(--duration-ui)] " +
  "ease-[var(--ease-out-soft)] focus-within:border-brand-soft focus-within:shadow-[var(--shadow-glow-sm)]";
const field = "w-full bg-transparent px-4 py-3 text-chalk placeholder:text-content-faint focus:outline-none";
const label = "block text-sm font-medium";
---

<form method="POST" action="/api/enrol" data-enrol-form class:list={["flex flex-col gap-5", className]}>
  <div>
    <label for="enrol-name" class={label}>Your name</label>
    <div class={shell}>
      <input id="enrol-name" name="name" type="text" required autocomplete="name" class={field} />
    </div>
  </div>

  <div>
    <label for="enrol-email" class={label}>Email</label>
    <div class={shell}>
      <input id="enrol-email" name="email" type="email" required autocomplete="email" class={field} />
    </div>
  </div>

  <div>
    <label for="enrol-stage" class={label}>Where are you in your studies?</label>
    <div class={shell}>
      <input
        id="enrol-stage"
        name="stage"
        type="text"
        required
        placeholder="e.g. 2nd year pharmacy, FY1 doctor"
        class={field}
      />
    </div>
  </div>

  <div>
    <label for="enrol-goals" class={label}>What do you want to get out of the program?</label>
    <div class={shell}>
      <textarea id="enrol-goals" name="goals" rows="4" class:list={[field, "block resize-y"]}></textarea>
    </div>
  </div>

  <label class="flex items-start gap-3 text-sm">
    {/* The OS checkbox is the last rounded, antialiased, blue-when-checked
        object on the page. Drawn here instead: a plain square box matching
        every other control, with a tick built from the same pixel-glyph hand
        as the site's arrows. The real input stays inside the box, transparent
        and full-size, so it keeps its own semantics, hit target and keyboard
        behaviour — `has-[:focus-visible]` lifts a glow onto the wrapper since
        the real outline draws around the invisible input, not the visible box. */}
    <span
      class="relative mt-0.5 grid size-[18px] shrink-0 place-items-center border border-border bg-surface-raised transition-[background-color,border-color,box-shadow] duration-[var(--duration-ui)] has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500 has-[:focus-visible]:border-brand-soft has-[:focus-visible]:shadow-[var(--shadow-glow-sm)]"
    >
      <input type="checkbox" name="consent" required class="peer absolute inset-0 cursor-pointer appearance-none" />
      <svg
        viewBox="0 0 16 16"
        aria-hidden="true"
        fill="currentColor"
        class="pointer-events-none size-3 text-chalk opacity-0 transition-opacity duration-[var(--duration-ui)] peer-checked:opacity-100"
      >
        <rect x="2" y="7" width="2" height="2"></rect>
        <rect x="4" y="9" width="2" height="2"></rect>
        <rect x="6" y="11" width="2" height="2"></rect>
        <rect x="8" y="9" width="2" height="2"></rect>
        <rect x="10" y="7" width="2" height="2"></rect>
        <rect x="12" y="5" width="2" height="2"></rect>
      </svg>
    </span>
    <span>
      I agree to the <a href="/legal/privacy" class="underline">privacy policy</a> and to being
      contacted about my application.
    </span>
  </label>

  {/* Honeypot. */}
  <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute h-0 w-0 overflow-hidden opacity-0" />

  <Button type="submit" variant="glow" size="md" class="self-start">Submit application</Button>

  <p data-enrol-status role="status" aria-live="polite" class="min-h-5 text-sm text-content-muted"></p>
</form>

<script>
  function initEnrol() {
    const form = document.querySelector<HTMLFormElement>("[data-enrol-form]");
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "true";

    const status = form.querySelector<HTMLElement>("[data-enrol-status]");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!status || !submit) return;

      submit.disabled = true;
      status.textContent = "Sending…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const result = await response.json();

        status.textContent = result.message ?? (response.ok ? "Application received." : "Something went wrong.");
        if (response.ok) form.reset();
      } catch {
        status.textContent = "Network error. Please try again.";
      } finally {
        submit.disabled = false;
      }
    });
  }

  initEnrol();
  document.addEventListener("astro:page-load", initEnrol);
</script>
