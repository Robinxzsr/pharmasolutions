---
/**
 * BlogCard — one article tile on /blog. Deliberately built as the same shop
 * tile as ProtocolCard (cover, halftone hover reveal, larger display title,
 * three-line clamp, one full-card link) so the two "grid of cover-image
 * cards" moments on the site read as one system rather than two components
 * that happen to look similar — see ProtocolCard.astro and `halftone` in
 * global.css for the reasoning behind the hover treatment itself. The
 * outer-frame hover is `shine` — see global.css and ProtocolCard.astro.
 *
 * The footer swaps price for author + date (left) and an estimated read
 * time (right), echoing the tag-badge/byline layout of the glass-card
 * reference this was built from — but the read time is computed from the
 * post's own word count, not invented, and the byline has no fake avatar
 * photo: coaches without a `portrait` get an initial instead, the same
 * "honest placeholder" rule CoverPlaceholder already follows for covers.
 *
 * The whole text block below the cover is a flex column with the footer
 * pushed down by `mt-auto`: description length varies post to post, and a
 * grid row already stretches every card to the tallest one in it (default
 * `align-items: stretch`), so without this the byline lands at a different
 * height on every card in the row instead of lining up along one shelf.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import CoverPlaceholder from "../ui/CoverPlaceholder.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, publishedAt, cover, coverAlt, tags } = post.data;

const author = await getEntry(post.data.author);

/** ~200 words/minute, rounded up so a short post never reads as "0 min". */
const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const formattedDate = publishedAt.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<a href={`/blog/${post.id}`} class="group/card shine flex h-full flex-col border border-border bg-surface-raised">
  <div class="relative shrink-0 overflow-hidden">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ""}
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 344px, (min-width: 640px) 45vw, 90vw"
          class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out group-hover/card:scale-105"
        />
      ) : (
        <CoverPlaceholder class="aspect-[16/10] w-full transition-transform duration-500 ease-out group-hover/card:scale-105" />
      )
    }

    {/* Halftone screen: dots multiply onto the cover's own tones instead of a flat tint sitting over it. */}
    <div
      class="halftone pointer-events-none absolute inset-0 opacity-0 mix-blend-multiply transition-opacity duration-300 ease-out group-hover/card:opacity-100 group-focus-visible/card:opacity-100"
    >
    </div>

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface/80 to-transparent opacity-0 transition-opacity duration-300 ease-out group-hover/card:opacity-100 group-focus-visible/card:opacity-100"
    >
    </div>

    {
      tags.length > 0 && (
        <div class="absolute bottom-3 left-3 flex flex-wrap gap-1.5">
          {tags.slice(0, 2).map((tag) => (
            <span class="border border-border bg-void-950/80 px-2.5 py-1 text-xs font-display font-bold text-content-muted">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div
      class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 ease-out group-hover/card:opacity-100 group-focus-visible/card:opacity-100"
    >
      <span
        class="inline-flex items-center gap-2 border border-chalk bg-void-950/90 px-5 py-2.5 font-display text-sm font-bold uppercase tracking-[0.04em] text-chalk"
      >
        Read article
        <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3.5 shrink-0 translate-y-[0.06em]">
          <rect x="1" y="6" width="8" height="4" fill="currentColor"></rect>
          <rect x="9" y="2" width="2" height="12" fill="currentColor"></rect>
          <rect x="11" y="4" width="2" height="8" fill="currentColor"></rect>
          <rect x="13" y="6" width="2" height="4" fill="currentColor"></rect>
        </svg>
      </span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h2 class="line-clamp-2 text-[length:var(--text-display-card)] text-chalk">{title}</h2>
    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-content-muted">{description}</p>

    {/* mt-auto: pinned to the bottom of the flex column regardless of how
        much room the title and description above took up, so this shelf
        lines up across every card in the row. */}
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-border pt-4">
      <div class="flex min-w-0 items-center gap-2">
        {
          author?.data.portrait ? (
            <span class="size-8 shrink-0 overflow-hidden border border-border">
              <Image src={author.data.portrait} alt="" width={32} height={32} class="size-full object-cover" />
            </span>
          ) : (
            <span class="flex size-8 shrink-0 items-center justify-center border border-border bg-void-800 font-display text-sm font-bold text-content-muted">
              {author?.data.name?.[0] ?? "?"}
            </span>
          )
        }
        <div class="min-w-0 text-xs leading-tight">
          <p class="truncate text-content">{author?.data.name ?? "Unknown"}</p>
          <p class="text-content-faint">{formattedDate}</p>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-1 text-xs text-content-faint">
        <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3.5 shrink-0 translate-y-[0.06em]" fill="currentColor">
          <rect x="6" y="2" width="4" height="1"></rect>
          <rect x="4" y="3" width="2" height="1"></rect><rect x="10" y="3" width="2" height="1"></rect>
          <rect x="3" y="4" width="1" height="1"></rect><rect x="12" y="4" width="1" height="1"></rect>
          <rect x="2" y="5" width="1" height="6"></rect><rect x="13" y="5" width="1" height="6"></rect>
          <rect x="3" y="11" width="1" height="1"></rect><rect x="12" y="11" width="1" height="1"></rect>
          <rect x="4" y="12" width="2" height="1"></rect><rect x="10" y="12" width="2" height="1"></rect>
          <rect x="6" y="13" width="4" height="1"></rect>
          <rect x="7" y="5" width="1" height="4"></rect><rect x="7" y="8" width="3" height="1"></rect>
        </svg>
        {readMinutes} min
      </div>
    </div>
  </div>
</a>
