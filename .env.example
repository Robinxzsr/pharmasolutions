# Copy to `.env` and fill in. Never commit `.env`.
# Schema and validation live in `astro.config.mjs` under `env.schema`.

# Stripe — required only for /pricing checkout and the webhook route.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Where enrolment applications are delivered.
ENROL_NOTIFY_EMAIL=
